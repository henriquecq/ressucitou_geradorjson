  {
    "html": "SALVE RAINHA",
    "title": "SALVE RAINHA",
    "subtitle": "Hino lat. «Salve Regina»",
    "color": "#FFFFFF",
    "capo": "",
    "sourcePages": [
      167
    ],
    "rows": [
      {
        "text": "Salve Rainha, Mãe de misericórdia,",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            14,
            "La-"
          ],
          [
            27,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 92.7
      },
      {
        "text": "SALVE RAINHA, MÃE DE MISERICÓRDIA,",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            14,
            "La-"
          ],
          [
            27,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 116.7
      },
      {
        "text": "vida, doçura e esperança nossa.",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            25,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 152.7
      },
      {
        "text": "Salve!",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 176.7
      },
      {
        "text": "A vós bradamos, os degredados filhos de Eva.",
        "role": "",
        "bold": false,
        "notes": [
          [
            9,
            "La-"
          ],
          [
            40,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 200.7
      },
      {
        "text": "A vós suspiramos, gemendo e chorando,",
        "role": "",
        "bold": false,
        "notes": [
          [
            9,
            "La-"
          ],
          [
            30,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 224.7
      },
      {
        "text": "neste vale de lágrimas.",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            14,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 248.7
      },
      {
        "text": "NESTE VALE DE LÁGRIMAS.",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            14,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 272.7
      },
      {
        "text": "Eia, pois, Senhora, Advogada nossa.",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            20,
            "Fa"
          ],
          [
            29,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 308.7
      },
      {
        "text": "Esses vossos olhos misericordiosos a nós volvei,",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            44,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 332.7
      },
      {
        "text": "e, depois deste desterro, mostrai-nos Jesus,",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            40,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 356.7
      },
      {
        "text": "bendito fruto do vosso ventre.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 167,
        "sourceY": 380.7
      },
      {
        "text": "Ó clemente! Ó piedosa! Ó doce, Virgem Maria!",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            17,
            "La-"
          ],
          [
            40,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 404.7
      },
      {
        "text": "Ó CLEMENTE! Ó PIEDOSA! Ó DOCE, VIRGEM MARIA!",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            17,
            "La-"
          ],
          [
            40,
            "Mi-"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 428.7
      },
      {
        "text": "Rogai por nós, Santa Mãe de Deus!",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            28,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 464.7
      },
      {
        "text": "Para que sejamos dignos das promessas",
        "role": "",
        "bold": false,
        "notes": [
          [
            31,
            "Fa"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 488.7
      },
      {
        "text": "de Jesus, de Jesus Cristo.",
        "role": "",
        "bold": false,
        "notes": [
          [
            6,
            "Mi"
          ]
        ],
        "sourcePage": 167,
        "sourceY": 512.7
      }
    ],
