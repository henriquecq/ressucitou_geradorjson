        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            20,
            "Mi"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 428.7
      },
      {
        "text": "cortou as rédeas dos malvados.",
