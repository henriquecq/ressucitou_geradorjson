      {
        "text": "por amor de meus irmãos,",
        "role": "",
        "bold": false,
        "notes": [
          [
            19,
            "Mi-"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 116.7
      },
      {
        "text": "deixa-me que hoje te diga:",
        "role": "",
        "bold": false,
        "notes": [
          [
            21,
            "Si7"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 140.7
      },
      {
        "text": "A paz contigo!",
        "role": "",
        "bold": false,
        "notes": [
          [
            8,
            "Mi-"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 164.7
      },
      {
        "text": "Que alegria quando me disseram:",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 200.7
      },
      {
        "text": "“Vamos para a Casa do Senhor!”",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            24,
            "Mi-"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 224.7
      },
      {
        "text": "OS NOSSOS PÉS JÁ ESTÃO PISANDO",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            25,
            "Si7"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 248.7
      },
      {
        "text": "AS TUAS PORTAS, JERUSALÉM!",
        "role": "",
        "bold": true,
        "notes": [
          [
            22,
            "Mi-"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 272.7
      },
      {
        "text": "JERUSALÉM, JERUSALÉM,",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Mi-"
          ]
        ],
        "sourcePage": 154,
        "sourceY": 308.7
      },
      {
