        "bold": false,
        "notes": [
          [
            37,
            "La-"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 116.7
      },
      {
        "text": "MUITO ME PERSEGUIRAM",
        "role": "A.",
        "bold": true,
        "notes": [],
        "sourcePage": 130,
        "sourceY": 152.7
      },
      {
        "text": "DESDE A JUVENTUDE,",
        "role": "",
        "bold": true,
        "notes": [
          [
            14,
            "Mi"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 176.7
      },
      {
        "text": "MUITO ME PERSEGUIRAM,",
        "role": "",
        "bold": true,
        "notes": [],
        "sourcePage": 130,
        "sourceY": 200.7
      },
      {
        "text": "MAS NÃO PUDERAM COMIGO.",
        "role": "",
        "bold": true,
        "notes": [
          [
            18,
            "La-"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 224.7
      },
      {
        "text": "Sobre as minhas costas araram aradores,",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            33,
            "Mi"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 260.7
      },
      {
        "text": "sobre as minhas costas alongaram seus sulcos.",
        "role": "",
        "bold": false,
        "notes": [
          [
            38,
            "La-"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 284.7
      },
      {
        "text": "SOBRE AS MINHAS COSTAS",
        "role": "A.",
        "bold": true,
        "notes": [],
        "sourcePage": 130,
        "sourceY": 320.7
      },
      {
        "text": "ARARAM ARADORES,",
        "role": "",
        "bold": true,
        "notes": [
          [
            10,
            "Mi"
          ]
        ],
        "sourcePage": 130,
        "sourceY": 344.7
      },
      {
