  {
    "html": "O MESMO DEUS",
    "page": 253,
    "title": "O MESMO DEUS",
    "subtitle": "2ª Coríntios 4, 6-12",
    "color": "#c7d7e8",
    "rows": [
      {
        "text": "O mesmo Deus que disse:",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Re"
          ],
          [
            17,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 92.7,
        "blankBefore": true
      },
      {
        "text": "‘‘Do seio das trevas brilhe a luz’’,",
        "role": "",
        "bold": false,
        "notes": [
          [
            15,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 116.7,
        "blankBefore": false
      },
      {
        "text": "fez brilhar a luz em nossos corações,",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 140.7,
        "blankBefore": false
      },
      {
        "text": "para irradiar o conhecimento de sua glória,",
        "role": "",
        "bold": false,
        "notes": [
          [
            10,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 164.7,
        "blankBefore": false
      },
      {
        "text": "que está no rosto de Cristo.",
        "role": "",
        "bold": false,
        "notes": [
          [
            6,
            "La"
          ],
          [
            21,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 188.7,
        "blankBefore": false
      },
      {
        "text": "QUE ESTÁ NO ROSTO DE CRISTO.",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            6,
            "La"
          ],
          [
            21,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 212.7,
        "blankBefore": true
      },
      {
        "text": "Mas levamos este tesouro",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 248.7,
        "blankBefore": true
      },
      {
        "text": "em vasos de barro.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 272.7,
        "blankBefore": false
      },
      {
        "text": "MAS LEVAMOS ESTE TESOURO",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 296.7,
        "blankBefore": true
      },
      {
        "text": "EM VASOS DE BARRO.",
        "role": "",
        "bold": true,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 320.7,
        "blankBefore": false
      },
      {
        "text": "Para que se manifeste",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 356.7,
        "blankBefore": true
      },
      {
        "text": "que o sublime deste amor",
        "role": "",
        "bold": false,
        "notes": [
          [
            21,
            "La"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 380.7,
        "blankBefore": false
      },
      {
        "text": "provém de Deus, provém de Deus",
        "role": "",
        "bold": false,
        "notes": [
          [
            10,
            "Si-"
          ],
          [
            15,
            "Sol"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 404.7,
        "blankBefore": false
      },
      {
        "text": "e que não vem de nós.",
        "role": "",
        "bold": false,
        "notes": [
          [
            17,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 428.7,
        "blankBefore": false
      },
      {
        "text": "LEVANDO SEMPRE EM NOSSO CORPO",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            8,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 464.7,
        "blankBefore": true
      },
      {
        "text": "O MORRER DE JESUS, PARA QUE",
        "role": "",
        "bold": true,
        "notes": [
          [
            14,
            "La"
          ],
          [
            25,
            "Si-"
          ],
          [
            27,
            "Sol"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 488.7,
        "blankBefore": false
      },
      {
        "text": "SE MANIFESTE EM NOSSO CORPO",
        "role": "",
        "bold": true,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 512.7,
        "blankBefore": false
      },
      {
        "text": "QUE ESTÁ RESSUSCITADO.",
        "role": "",
        "bold": true,
        "notes": [
          [
            17,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 536.7,
        "blankBefore": false
      },
      {
        "text": "Atribulados, mas não desesperados;",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 92.7,
        "blankBefore": true
      },
      {
        "text": "perseguidos, mas não abandonados;",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 116.7,
        "blankBefore": false
      },
      {
        "text": "abatidos, mas não aniquilados.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 140.7,
        "blankBefore": false
      },
      {
        "text": "LEVANDO SEMPRE ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            8,
            "Si-"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 176.7,
        "blankBefore": true
      },
      {
        "text": "Enquanto nós morremos",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 212.7,
        "blankBefore": true
      },
      {
        "text": "o mundo recebe a vida.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 236.7,
        "blankBefore": false
      },
      {
        "text": "ENQUANTO NÓS MORREMOS",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Fa#"
          ]
        ],
        "sourcePage": 253,
        "sourceY": 260.7,
        "blankBefore": true
      },
      {
        "text": "O MUNDO RECEBE A VIDA.",
        "role": "",
        "bold": true,
        "notes": [],
        "sourcePage": 253,
        "sourceY": 284.7,
        "blankBefore": false
      },
      {
        "text": "LEVANDO SEMPRE ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            8,
            "Si-"
          ]
        ],
        "sourcePage": 253,
