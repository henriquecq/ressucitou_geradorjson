        "role": "",
        "bold": false,
        "notes": [
          [
            7,
            "Fa"
          ],
          [
            24,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 224.7,
        "blankBefore": false
      },
      {
        "text": "COMO ÉS BELA, AMADA MINHA,",
