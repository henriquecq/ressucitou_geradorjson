        "role": "",
        "bold": false,
        "notes": [
          [
            12,
            "Re-"
          ],
          [
            19,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 308.7,
        "blankBefore": false
      },
      {
        "text": "EU VOS CONJURO, FILHAS DE JERUSALÉM,",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            11,
            "La-"
          ],
          [
            23,
            "Re-"
          ],
          [
            32,
            "La-"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 344.7,
        "blankBefore": true
      },
