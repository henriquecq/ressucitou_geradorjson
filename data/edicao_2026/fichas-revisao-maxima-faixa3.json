  {
    "html": "PAI NOSSO",
    "page": 227,
    "title": "PAI NOSSO*",
    "subtitle": "",
    "color": "#FFF4B3",
    "rows": [
      {
        "text": "ABBA, ABBA PAI.",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Re-"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 92.7,
        "blankBefore": true
      },
      {
        "text": "PAI NOSSO QUE ESTAIS NOS CÉUS,",
        "role": "",
        "bold": true,
        "notes": [],
        "sourcePage": 227,
        "sourceY": 128.7,
        "blankBefore": true
      },
      {
        "text": "SANTIFICADO SEJA O VOSSO NOME;",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            12,
            "La-"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 152.7,
        "blankBefore": false
      },
      {
        "text": "VENHA A NÓS O VOSSO REINO,",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Sol-"
          ],
          [
            20,
            "La"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 176.7,
        "blankBefore": false
      },
      {
        "text": "SEJA FEITA A VOSSA VONTADE,",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Sib"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 200.7,
        "blankBefore": false
      },
      {
        "text": "ASSIM NA TERRA COMO NO CÉU.",
        "role": "",
        "bold": true,
        "notes": [
          [
            23,
            "La"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 224.7,
        "blankBefore": false
      },
      {
        "text": "O PÃO NOSSO DE CADA DIA",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Re-"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 260.7,
        "blankBefore": true
      },
      {
        "text": "NOS DAI HOJE;",
        "role": "",
        "bold": true,
        "notes": [],
        "sourcePage": 227,
        "sourceY": 284.7,
        "blankBefore": false
      },
      {
        "text": "PERDOAI-NOS AS NOSSAS OFENSAS;",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            23,
            "La-"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 308.7,
        "blankBefore": false
      },
      {
        "text": "ASSIM COMO NÓS PERDOAMOS",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Sol-"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 332.7,
        "blankBefore": false
      },
      {
        "text": "A QUEM NOS TEM OFENDIDO;",
        "role": "",
        "bold": true,
        "notes": [
          [
            19,
            "La"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 356.7,
        "blankBefore": false
      },
      {
        "text": "E NÃO NOS DEIXEIS CAIR EM TENTAÇÃO,",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Sib"
          ],
          [
            29,
            "La"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 380.7,
        "blankBefore": false
      },
      {
        "text": "MAS LIVRAI-NOS DO MAL.",
        "role": "",
        "bold": true,
        "notes": [
          [
            18,
            "Re-"
          ]
        ],
        "sourcePage": 227,
        "sourceY": 404.7,
        "blankBefore": false
      }
    ],
    "repeatBlocks": [],
    "footnote": "* Para as comunidades que viveram a última etapa do Pai Nosso."
  },
