          [
            15,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 200.7,
        "blankBefore": false
      },
      {
        "text": "E A BANDEIRA QUE DESFRALDA",
        "role": "",
        "bold": true,
        "notes": [
          [
            7,
            "Re-"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 224.7,
        "blankBefore": true
      },
      {
        "text": "SOBRE MIM É O AMOR.",
        "role": "",
        "bold": true,
        "notes": [
          [
            15,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 248.7,
        "blankBefore": false
      },
      {
        "text": "Sua mão esquerda está sobre minha cabeça,",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            11,
            "Re-"
          ],
          [
            36,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 284.7,
        "blankBefore": true
      },
