        "bold": true,
        "notes": [
          [
            8,
            "Fa"
          ],
          [
            23,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 284.7,
        "blankBefore": false
      },
      {
        "text": "POMBAS SÃO TEUS OLHOS,",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Re-"
          ],
          [
            16,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 308.7,
        "blankBefore": false
      },
      {
        "text": "POMBAS SÃO TEUS OLHOS!",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Re-"
          ],
          [
            16,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 332.7,
        "blankBefore": false
      },
      {
        "text": "COMO ÉS FORMOSO, MEU AMADO,",
        "role": "",
        "bold": true,
        "notes": [
          [
            11,
            "Fa"
          ],
          [
            22,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 368.7,
        "blankBefore": true
      },
      {
        "text": "COMO ÉS FORMOSO, QUE DELICIOSO!",
        "role": "",
        "bold": true,
        "notes": [
          [
            11,
            "Fa"
          ],
          [
            27,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 392.7,
        "blankBefore": false
      },
      {
        "text": "A RELVA É NOSSO LEITO,",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Re-"
          ],
          [
            16,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 416.7,
        "blankBefore": false
      },
      {
        "text": "A RELVA É NOSSO LEITO.",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "Re-"
          ],
          [
            16,
            "Mi"
          ]
        ],
        "sourcePage": 264,
        "sourceY": 440.7,
        "blankBefore": false
      },
      {
