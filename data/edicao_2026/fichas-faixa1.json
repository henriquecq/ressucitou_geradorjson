          [
            18,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 512.7
      },
      {
        "text": "ESCONDE-ME ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Mi-"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 548.7
      },
      {
        "text": "Uma coisa peço a Iahweh,",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            20,
            "Do"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 92.7
      },
      {
        "text": "esta só estou buscando:",
        "role": "",
        "bold": false,
        "notes": [
          [
            17,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 116.7
      },
      {
        "text": "habitar na casa de Iahweh",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            22,
            "Do"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 140.7
      },
      {
        "text": "todos os dias de minha vida.",
        "role": "",
        "bold": false,
        "notes": [
          [
            22,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 164.7
      },
      {
        "text": "ESCONDE-ME ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Mi-"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 200.7
      },
      {
        "text": "Ele me oculta em sua tenda",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            20,
            "Do"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 236.7
      },
      {
        "text": "no dia da desgraça;",
        "role": "",
        "bold": false,
        "notes": [
          [
            13,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 260.7
      },
      {
        "text": "ele me esconderá no oculto de sua tenda,",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            34,
            "Do"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 284.7
      },
      {
        "text": "sobre sua rocha me levantará.",
        "role": "",
        "bold": false,
        "notes": [
          [
            26,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 308.7
      },
      {
        "text": "ESCONDE-ME ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "Mi-"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 344.7
      },
      {
        "text": "Escuta, Iahweh, meu grito,",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            20,
            "Do"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 380.7
      },
      {
        "text": "tem piedade, responde-me!",
        "role": "",
        "bold": false,
        "notes": [
          [
            22,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 404.7
      },
      {
        "text": "Sim, Iahweh, teu rosto procuro:",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Mi-"
          ],
          [
            26,
            "Do"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 428.7
      },
      {
        "text": "não me escondas teu rosto.",
        "role": "",
        "bold": false,
        "notes": [
          [
            20,
            "Si7"
          ]
        ],
        "sourcePage": 88,
        "sourceY": 452.7
      },
      {
        "text": "ESCONDE-ME ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
