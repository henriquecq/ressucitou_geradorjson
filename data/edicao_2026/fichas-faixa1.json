  {
    "html": "ESPEREI ESPEREI NO SENHOR",
    "title": "ESPEREI, ESPEREI NO SENHOR",
    "subtitle": "Salmo 40 (39)",
    "color": "#FFFFFF",
    "capo": "Braçadeira 3º Traste",
    "sourcePages": [
      90
    ],
    "rows": [
      {
        "text": "ESPEREI,",
        "role": "S.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 92.7
      },
      {
        "text": "ESPEREI NO SENHOR",
        "role": "",
        "bold": true,
        "notes": [
          [
            14,
            "Mi-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 116.7
      },
      {
        "text": "E ELE PARA MIM SE INCLINOU,",
        "role": "",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            23,
            "Mi-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 140.7
      },
      {
        "text": "OUVIU MEU GRITO,",
        "role": "",
        "bold": true,
        "notes": [
          [
            2,
            "Fa"
          ],
          [
            11,
            "Mi7"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 164.7
      },
      {
        "text": "TIROU-ME DA FOSSA DA MORTE.",
        "role": "",
        "bold": true,
        "notes": [
          [
            2,
            "Fa"
          ],
          [
            21,
            "Mi"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 188.7
      },
      {
        "text": "Tirou-me de um charco de lodo;",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            25,
            "Mi-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 224.7
      },
      {
        "text": "assentou meus pés sobre a rocha,",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            26,
            "Mi-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 248.7
      },
      {
        "text": "firmou meus passos",
        "role": "",
        "bold": false,
        "notes": [
          [
            3,
            "Fa"
          ],
          [
            12,
            "Mi7"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 272.7
      },
      {
        "text": "num caminho, num caminho de salvação.",
        "role": "",
        "bold": false,
        "notes": [
          [
            6,
            "Fa"
          ],
          [
            33,
            "Mi"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 296.7
      },
      {
        "text": "ESPEREI, ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 332.7
      },
      {
        "text": "Ele pôs na minha boca um canto novo,",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ],
          [
            31,
            "Mi-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 368.7
      },
      {
        "text": "um hino de louvor ao nosso Deus;",
        "role": "",
        "bold": false,
        "notes": [
          [
            3,
            "La-"
          ],
          [
            27,
            "Mi-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 392.7
      },
      {
        "text": "muitos verão e temerão,",
        "role": "",
        "bold": false,
        "notes": [
          [
            0,
            "Fa"
          ],
          [
            19,
            "Mi7"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 416.7
      },
      {
        "text": "e porão sua confiança no Senhor.",
        "role": "",
        "bold": false,
        "notes": [
          [
            5,
            "Fa"
          ],
          [
            28,
            "Mi"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 440.7
      },
      {
        "text": "ESPEREI, ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 476.7
      },
      {
        "text": "Feliz o homem que espera no Senhor",
        "role": "S.",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 93.2
      },
      {
        "text": "e não se volta para os soberbos,",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 105.7
      },
      {
        "text": "que não segue o caminho da mentira,",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 118.2
      },
      {
        "text": "feliz o homem que espera no Senhor.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 130.7
      },
      {
        "text": "ESPEREI, ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 164.7
      },
      {
        "text": "Senhor, quantas maravilhas,",
        "role": "S.",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 200.7
      },
      {
        "text": "quantos prodígios fizeste para conosco!",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 212.7
      },
      {
        "text": "Eu quisera anunciá-los e proclamá-los,",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 224.7
      },
      {
        "text": "mas são demais para que os possa enumerar.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 236.7
      },
      {
        "text": "ESPEREI, ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 272.7
      },
      {
        "text": "Não quiseste sacrifício nem oblação,",
        "role": "S.",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 308.7
      },
      {
        "text": "por isso abriste meu ouvido.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 320.7
      },
      {
        "text": "Não exigiste vítimas pelas culpas,",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 332.7
      },
      {
        "text": "então eu disse: “Eis-me aqui que venho,",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 344.7
      },
      {
        "text": "para fazer a tua vontade!”",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 356.7
      },
      {
        "text": "ESPEREI, ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 392.7
      },
      {
        "text": "No livro está escrito de mim:",
        "role": "S.",
        "bold": false,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 428.7
      },
      {
        "text": "que eu faça, Senhor, a tua vontade.",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 440.7
      },
      {
        "text": "Meu Deus, isto eu desejo:",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 452.7
      },
      {
        "text": "tua palavra nas minhas entranhas!",
        "role": "",
        "bold": false,
        "notes": [],
        "sourcePage": 90,
        "sourceY": 464.7
      },
      {
        "text": "ESPEREI, ...",
        "role": "A.",
        "bold": true,
        "notes": [
          [
            0,
            "La-"
          ]
        ],
        "sourcePage": 90,
        "sourceY": 500.7
      }
